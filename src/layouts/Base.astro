---
import '@fontsource/frank-ruhl-libre/300.css';
import '@fontsource/frank-ruhl-libre/400.css';
import '@fontsource/frank-ruhl-libre/700.css';
import '@fontsource/ibm-plex-sans-hebrew/300.css';
import '@fontsource/ibm-plex-sans-hebrew/400.css';
import '@fontsource/ibm-plex-sans-hebrew/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Footer from '../components/Footer.astro';
import StickyContact from '../components/StickyContact.astro';
import { SITE } from '../site';
import logoLight from '../assets/brand/logo-light.png';

interface Props { title: string; description: string; ogImage?: string; noindex?: boolean }
const { title, description, ogImage, noindex } = Astro.props;
const fullTitle = title === SITE.shortName ? `${SITE.shortName} | אדריכלות ותכנון ערים, נתניה` : `${title} | ${SITE.shortName}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const og = ogImage ? new URL(ogImage, SITE.url).href : new URL(logoLight.src, SITE.url).href;
const ld = {
  '@context': 'https://schema.org', '@type': 'ProfessionalService', additionalType: 'https://schema.org/ArchitecturalFirm',
  name: SITE.name, url: SITE.url, telephone: SITE.phones, foundingDate: String(SITE.founded),
  address: { '@type': 'PostalAddress', streetAddress: 'אוסישקין 40', addressLocality: 'נתניה', addressCountry: 'IL' },
};
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={og} />
  <meta name="theme-color" content="#1E1E1E" />
  <link rel="icon" type="image/png" href="/favicon.png" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('motion');
      try { if (sessionStorage.getItem('tsa-curtain') !== null) d.classList.add('curtain-in'); } catch (e) {}
      // safety net: if scripts fail, never leave content hidden
      setTimeout(function () { if (!window.__tsaReady) { d.classList.remove('motion', 'curtain-in'); } }, 3500);
    })();
  </script>
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#main">דילוג לתוכן</a>
  <Header />
  <MobileMenu />
  <main id="main"><slot /></main>
  <Footer />
  <StickyContact />
  <div class="curtain blueprint-bg" id="curtain" aria-hidden="true"><b id="curtain-title"></b></div>
  <div class="view-cursor" id="view-cursor" aria-hidden="true">צפייה</div>
  <script>
    import '../scripts/core';
    import '../scripts/header';
    import '../scripts/curtain';
    import '../scripts/reveals';
  </script>
</body>
</html>
