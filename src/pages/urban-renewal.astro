---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SketchCompare from '../components/home/SketchCompare.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Accordion from '../components/Accordion.astro';
import ContactBlock from '../components/home/ContactBlock.astro';
import { photo, urbanRenewalProjects } from '../lib/content';
const projects = urbanRenewalProjects();
const hero = (projects.find((p) => p.title === 'אוסישקין') ?? projects[0])?.cover;
const steps = [
  { t: 'היכרות עם נציגות הדיירים', d: 'פגישה ראשונה עם נציגות הבניין: מה קיים היום, מה הדיירים מצפים לקבל ומה המגבלות.' },
  { t: 'בדיקת היתכנות ותכנון ראשוני', d: 'בדיקה תכנונית של המגרש, זכויות הבנייה והתוכניות החלות עליו, ותכנון ראשוני של הבניין החדש.' },
  { t: 'תב״ע והיתר בנייה', d: 'הכנת התוכנית, הגשתה לוועדות התכנון וליווי הליך הרישוי עד לקבלת היתר הבנייה.' },
  { t: 'ליווי אדריכלי עד המסירה', d: 'פיקוח עליון וליווי אדריכלי לאורך הבנייה, עד שהדיירים מקבלים את המפתח לדירה החדשה.' },
];
const faq = [
  { q: 'מי יוזם פרויקט פינוי-בינוי?', a: 'פרויקט יכול להתחיל ביוזמת הדיירים, שמתארגנים ובוחרים נציגות, ביוזמת יזם שפונה לבעלי הדירות, או ביוזמת הרשות המקומית במתחמים שהיא מקדמת. בכל מקרה נדרשת הסכמה של רוב בעלי הדירות כפי שקובע החוק.' },
  { q: 'כמה זמן לוקח התהליך?', a: 'פינוי-בינוי הוא תהליך ארוך שכולל התארגנות, בחירת יזם, תכנון, אישור תוכנית, היתר בנייה ובנייה. משך הזמן משתנה מאוד בין פרויקטים ותלוי בעיקר בהליכי התכנון והאישורים, ולכן חשוב לקבל הערכה לגבי המתחם הספציפי.' },
  { q: 'מה מקבל דייר בפרויקט?', a: 'בדרך כלל דירה חדשה בבניין חדש במקום הדירה הישנה, ובמקרים רבים דירה גדולה יותר עם תוספות כמו מרפסת, חניה ומחסן. התמורה המדויקת נקבעת בהסכם בין הדיירים ליזם, ומשתנה מפרויקט לפרויקט.' },
  { q: 'מה תפקיד האדריכל?', a: 'האדריכל בודק את ההיתכנות התכנונית, מתכנן את הבניין והדירות החדשות, מכין את התוכנית ואת הבקשה להיתר, ומלווה את הפרויקט מול הוועדות ולאורך הבנייה. האדריכל הוא גם מי שמתרגם את צורכי הדיירים לתכנון בפועל.' },
  { q: 'מה צריכה לעשות נציגות הדיירים?', a: 'לייצג את בעלי הדירות, לאסוף את עמדותיהם, להיפגש עם יזמים ואנשי מקצוע ולהשוות בין הצעות. מומלץ שהנציגות תיעזר בעורך דין ובאנשי מקצוע מטעם הדיירים לאורך הדרך.' },
];
---
<Base title="התחדשות עירונית" description="פינוי-בינוי והתחדשות עירונית: טטרו שחר אדריכלים מלווים דיירים ויזמים מהבדיקה הראשונה ועד המסירה. מה זה פינוי ובינוי, איך זה עובד ושאלות נפוצות.">
  <PageHero title="התחדשות עירונית" kicker="פינוי-בינוי" lead="בניינים ישנים מתחלפים בבניינים חדשים, עם דירה חדשה לכל דייר. אנחנו מלווים את הדיירים ואת היזם לאורך כל הדרך." image={hero} crumbs={[{ label: 'התחדשות עירונית' }]} />

  <section class="wrap ur-what">
    <div class="ur-what-grid">
      <h2 class="h2 split">מה זה פינוי-בינוי?</h2>
      <div class="prose" data-reveal="children">
        <p>פינוי-בינוי, כשמו כן הוא: מפנים בנייני רכבת ישנים משנות ה-50, בערים כמו נתניה, תל אביב, חיפה, רמת גן וגבעתיים. לרוב התשתיות בבניינים האלה גרועות והם כבר אינם בטוחים למגורים.</p>
        <p>במקום אותם בניינים, שרובם בני שלוש או ארבע קומות בלבד, מתפרשים על שטח גדול ומכילים מספר קטן יחסית של משפחות, מקימים בניינים חדשים ורבי קומות. כך, על אותה קרקע, נבנות הרבה יותר דירות חדשות.</p>
      </div>
    </div>
  </section>

  <SketchCompare sketch={photo('src/assets/photos/urban-renewal/ur-sketch.jpg')} render={photo('src/assets/photos/towers/גד מכנס.jpg')} teaser={false} />

  <section class="wrap on-stone ur-steps">
    <h2 class="h2 split">איך זה עובד</h2>
    <div class="timeline-wrap" id="timeline">
    <span class="tl-line" aria-hidden="true"><span id="tl-fill"></span></span>
    <ol class="timeline">
      {steps.map((s, i) => <li data-reveal><span class="tl-dot">0{i + 1}</span><div><h3>{s.t}</h3><p>{s.d}</p></div></li>)}
    </ol>
    </div>
  </section>

  <section class="wrap ur-faq">
    <div class="faq-grid">
      <h2 class="h2 split">שאלות נפוצות</h2>
      <Accordion items={faq} />
    </div>
  </section>

  {projects.length > 0 && (
    <section class="wrap on-stone">
      <div class="section-head"><h2 class="h2 split">פרויקטים של התחדשות עירונית</h2><a class="more-link" href="/projects/towers">מגדלים ומגורים <span class="arr">→</span></a></div>
      <div class="grid">{projects.map((p) => <ProjectCard project={p} />)}</div>
    </section>
  )}

  <ContactBlock variant="residents" />
</Base>
<style is:global>
  .ur-what-grid,.faq-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(32px,5vw,80px);align-items:start}
  .ur-what .prose p{font-size:clamp(17px,1.4vw,20px);line-height:1.8}
  .timeline-wrap{position:relative;margin-top:48px}
  .timeline{list-style:none;padding:0;margin:0;position:relative;display:grid;gap:clamp(32px,4vw,56px)}
  .tl-line{position:absolute;top:8px;bottom:8px;right:27px;width:2px;background:rgba(30,30,30,.15)}
  .tl-line span{position:absolute;inset:0;background:var(--red);transform-origin:top;transform:scaleY(1)}
  html.js.motion .tl-line span{transform:scaleY(0)}
  .timeline li{display:grid;grid-template-columns:56px 1fr;gap:clamp(18px,3vw,40px);align-items:start;position:relative}
  .tl-dot{width:56px;height:56px;border-radius:50%;background:var(--ink);color:#fff;display:grid;place-items:center;font-family:var(--serif);font-size:20px;position:relative;z-index:1}
  .timeline h3{font-family:var(--serif);font-weight:400;font-size:clamp(24px,2.4vw,34px);margin:8px 0 8px}
  .timeline p{color:var(--muted);line-height:1.7;max-width:60ch}
  .ur-steps .ur-steps-inner{max-width:900px}
  @media (max-width:820px){.ur-what-grid,.faq-grid{grid-template-columns:1fr}.compare{max-height:70vh}}
</style>
<script>
  import { gsap, onPage, reduced } from '../scripts/core';
  onPage(() => {
    if (reduced()) return;
    gsap.to('#tl-fill', { scaleY: 1, ease: 'none', scrollTrigger: { trigger: '#timeline', start: 'top 70%', end: 'bottom 60%', scrub: true } });
  });
</script>
