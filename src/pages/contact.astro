---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, tel } from '../site';
const mapSrc = 'https://www.google.com/maps?q=' + encodeURIComponent('אוסישקין 40 נתניה') + '&output=embed';
---
<Base title="צור קשר" description="צרו קשר עם טטרו שחר אדריכלים: 09-8820022, אוסישקין 40, נתניה. השאירו פרטים ונחזור אליכם.">
  <PageHero title="צור קשר" kicker="נשמח לשמוע על הפרויקט שלכם" lead="יזמים, נציגויות דיירים ובעלי מגרשים: השאירו פרטים ונחזור אליכם, או התקשרו ישירות." crumbs={[{ label: 'צור קשר' }]} short />

  <section class="wrap contact-page">
    <div class="cp-grid">
      <div class="cp-form">
        <h2 class="h3">השאירו פרטים</h2>
        <ContactForm />
      </div>
      <aside class="cp-info" data-reveal="children">
        <h2 class="h3">פרטי התקשרות</h2>
        {SITE.phones.map((p) => <a class="cb-line light" href={tel(p)}><small>טלפון</small><b dir="ltr">{p}</b></a>)}
        {SITE.email && <a class="cb-line light" href={`mailto:${SITE.email}`}><small>אימייל</small><b dir="ltr">{SITE.email}</b></a>}
        {SITE.whatsapp && <a class="btn wa" href={`https://wa.me/${SITE.whatsapp}`} target="_blank" rel="noopener"><span>שלחו הודעת וואטסאפ</span></a>}
        <div class="cb-line light"><small>כתובת</small><b>{SITE.address}</b></div>
        <div class="nav-links">
          <a class="btn ghost" href={SITE.wazeUrl} target="_blank" rel="noopener"><span>ניווט ב-Waze</span></a>
          <a class="btn ghost" href={SITE.mapsUrl} target="_blank" rel="noopener"><span>Google Maps</span></a>
        </div>
        <div class="map" id="map" data-src={mapSrc}>
          <div class="map-ph blueprint-bg">
            <svg viewBox="0 0 24 24" width="34" height="34" aria-hidden="true"><path d="M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z" fill="currentColor" /></svg>
            <b>{SITE.address}</b>
            <button type="button" class="btn sand" id="map-load"><span>הצגת מפה</span></button>
            <small>המפה נטענת מ-Google רק לאחר לחיצה</small>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>
<style is:global>
  .cp-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:clamp(40px,6vw,100px);align-items:start}
  .cp-form .h3,.cp-info .h3{font-family:var(--serif);font-weight:400;font-size:clamp(26px,2.4vw,34px);margin-bottom:24px}
  .cp-info{display:grid;gap:4px}
  .cb-line.light{border-bottom-color:rgba(30,30,30,.15)}
  .cb-line.light small{color:var(--muted)}
  .nav-links{display:flex;gap:10px;flex-wrap:wrap;margin:20px 0}
  .nav-links .btn{padding:10px 18px;font-size:14px}
  .btn.wa{background:#1f7a4d;color:#fff;margin-top:16px}
  .map{aspect-ratio:4/3;overflow:hidden;background:var(--ink);color:#fff}
  .map iframe{width:100%;height:100%;border:0}
  .map-ph{height:100%;display:grid;place-items:center;align-content:center;gap:12px;text-align:center;padding:24px;color:#fff}
  .map-ph svg{color:var(--red)}
  .map-ph small{color:var(--muted-on-ink);font-size:12px}
  @media (max-width:820px){.cp-grid{grid-template-columns:1fr}}
</style>
<script>
  import { onPage, $ } from '../scripts/core';
  onPage(() => {
    const map = $('#map'), btn = $('#map-load');
    btn?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = map!.dataset.src!; f.title = 'מפה: משרדי טטרו שחר אדריכלים'; f.loading = 'lazy'; f.referrerPolicy = 'no-referrer-when-downgrade';
      map!.replaceChildren(f);
    });
  });
</script>
