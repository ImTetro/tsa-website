---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { photo, getProjects, getClients, getTeam } from '../lib/content';
const projects = getProjects().filter((p) => !p.placeholder);
const hero = photo('src/assets/photos/towers/05.jpg');
const sidePic = (projects.find((p) => p.category === 'commercial') ?? projects[0]).cover;
const partners = getTeam().partners;
const clients = getClients().length;
const departments = [
  { t: 'מחלקת תכנון', d: 'תכנון אדריכלי מהקונספט ועד התוכניות לביצוע, בכל קנה מידה.' },
  { t: 'מחלקת תב״ע', d: 'הכנת תוכניות בניין עיר וליווי מול הוועדות המקומיות והמחוזיות.' },
  { t: 'מחלקת רישוי', d: 'הגשת בקשות להיתר וליווי תהליך הרישוי עד קבלת ההיתר.' },
  { t: 'מחלקת הדמיות', d: 'הדמיות ממוחשבות שמציגות את הפרויקט עוד לפני שהונחה האבן הראשונה.' },
];
const types = ['שכונות מגורים ובנייה רוויה', 'מרכזי פנאי ומסחר', 'בתי מלון', 'מבני משרדים', 'מבני תעשייה', 'בתי חולים', 'בתי ספר', 'הפרשת קרקעות'];
---
<Base title="אודות" description="טטרו שחר אדריכלים: משרד אדריכלים שנוסד ב-1978 בנתניה על ידי אדריכל גבי טטרו. כ-25 אנשי מקצוע, מחלקות תכנון, תב״ע, רישוי והדמיות.">
  <PageHero title="אודות המשרד" kicker="מאז 1978" lead="יותר מארבעה עשורים של תכנון אדריכלי ברחבי הארץ: אלפי יחידות דיור, מרכזי מסחר ומשרדים, בתי מלון ומבני ציבור." image={hero} crumbs={[{ label: 'אודות' }]} />

  <section class="wrap about-history">
    <div class="ah-grid">
      <div class="ah-text">
        <span class="kicker-dark">ההיסטוריה</span>
        <h2 class="h2 split">משרד שהתחיל בקו אחד</h2>
        <div class="prose" data-reveal="children">
          <p>חברת גבי טטרו בע״מ נוסדה בשנת 1978 על ידי אדריכל גבי טטרו. לחברה ניסיון רב בתכנון אדריכלי ברחבי הארץ, הכולל מרכזי מסחר ומשרדים, בנייה רוויה למגורים, בתי מלון, הפרשת קרקעות ותעשייה.</p>
          <p>המשרד פועל יותר מ-40 שנה ותכנן אלפי יחידות דיור, תוך הקפדה על כל היבט של התכנון האדריכלי. במשך השנים זכה המשרד בתחרויות רבות בארץ ובחו״ל.</p>
        </div>
      </div>
      <figure class="ah-pic" data-reveal><Picture src={sidePic} alt="" widths={[600, 1000]} sizes="(max-width:820px) 100vw, 40vw" formats={['avif', 'webp']} /></figure>
    </div>
  </section>

  <section class="wrap on-stone about-partners">
    <span class="kicker-dark">השותפות</span>
    <h2 class="h2 split">טטרו שחר אדריכלים</h2>
    <div class="prose" data-reveal="children" style="margin-top:24px">
      <p>בשנת 2010 הצטרף גדי שחר כשותף, והביא איתו ניסיון של כ-30 שנה בטכנולוגיות בנייה מתקדמות והתמחות בניהול ובליווי של פרויקטים מורכבים.</p>
      <p>העבודה המשותפת לאורך השנים בין אדריכל גבי טטרו לגדי שחר יצרה את חברת טטרו שחר אדריכלים בע״מ, המתמחה במתן שירותי תכנון ואדריכלות לכל סוגי הפרויקטים, בארץ ובחו״ל.</p>
    </div>
    <ul class="partner-names" data-reveal="children">
      {partners.map((p) => <li><b>{p.name}</b><span>{p.role}</span></li>)}
    </ul>
  </section>

  <section class="wrap about-types">
    <div class="section-head"><h2 class="h2 split">מה אנחנו מתכננים</h2><a class="more-link" href="/projects">לפרויקטים <span class="arr">→</span></a></div>
    <ul class="types" data-reveal="children">{types.map((t, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{t}</li>)}</ul>
  </section>

  <section class="wrap on-ink blueprint-bg about-depts">
    <h2 class="h2 split">ארבע מחלקות, מעטפת אחת</h2>
    <p class="lead" style="margin-top:18px">המשרד מונה כיום כ-25 אנשי מקצוע. כדי לתת לכל פרויקט מעטפת מלאה וייעוץ אדריכלי בכל שלבי התכנון, הצוות מחולק למחלקות:</p>
    <div class="depts" data-reveal="children">
      {departments.map((d, i) => <div class="dept"><span class="dept-n">0{i + 1}</span><h3>{d.t}</h3><p>{d.d}</p></div>)}
    </div>
  </section>

  <section class="wrap about-values">
    <blockquote class="quote" data-reveal>
      <p>״האומנות היא לא סטנדרטית,<br />היא רב גונית״</p>
    </blockquote>
    <div class="prose values-text" data-reveal="children">
      <p>בכל פרויקט אנחנו מתאימים את היצירה ללקוח, והחדשנות מגיעה מלמידה מתמדת של המתרחש בעולם.</p>
      <p>המשרד רואה בצורכי הלקוחות ערך עליון, ומיישם את דרישותיהם לתכנון פונקציונלי ברמה אדריכלית גבוהה. הפרויקטים מתפתחים נדבך על נדבך, עם ירידה לפרטי פרטים, כמו מיקומו של הפרויקט והסביבה שבה הוא נמצא, עד לקבלת תוצר מושלם ומוגמר.</p>
      <p>במהלך יותר מ-40 שנות פעילות צברה החברה ניסיון ומוניטין רבים, ותכננה מגוון רחב של פרויקטים עבור חברות ויזמים מהמובילים בענף. אצל רובם הפך המשרד ל״אדריכלי הבית״.</p>
    </div>
  </section>

  <section class="wrap-tight on-stone">
    <div class="facts">
      <div class="fact"><b data-to="1978" data-from="1950">1978</b><span>שנת ההקמה</span></div>
      <div class="fact"><b data-to="25">25</b><span>אנשי מקצוע במשרד</span></div>
      <div class="fact"><b data-to={clients}>{clients}</b><span>יזמים וגופים ציבוריים בין לקוחותינו</span></div>
    </div>
  </section>

  <section class="wrap about-cta">
    <div class="cta-pair">
      <a class="cta-card" href="/team"><small>הכירו את האנשים</small><b>הצוות שלנו</b><span class="arr">←</span></a>
      <a class="cta-card dark" href="/contact"><small>יש לכם פרויקט?</small><b>צרו קשר</b><span class="arr">←</span></a>
    </div>
  </section>
</Base>
<style is:global>
  .ah-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(32px,5vw,80px);align-items:center}
  .ah-text .h2{margin-bottom:24px}
  .ah-pic{margin:0;aspect-ratio:4/5;overflow:hidden}
  .ah-pic img{width:100%;height:100%;object-fit:cover}
  .partner-names{list-style:none;display:flex;gap:clamp(24px,5vw,80px);margin-top:36px;flex-wrap:wrap;padding:0}
  .partner-names li{display:grid;gap:4px}
  .partner-names b{font-family:var(--serif);font-weight:400;font-size:clamp(26px,2.6vw,38px)}
  .partner-names span{color:var(--muted);font-size:15px}
  .types{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:0 48px;margin-top:20px}
  .types li{display:flex;gap:16px;align-items:baseline;padding:18px 0;border-bottom:1px solid rgba(30,30,30,.14);font-size:clamp(18px,1.6vw,22px)}
  .types li span{font-family:var(--serif);color:#B90006;font-size:16px}
  .depts{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(12px,1.6vw,24px);margin-top:44px}
  .dept{border:1px solid rgba(200,200,200,.25);padding:28px 22px 32px;background:rgba(10,33,49,.55);transition:background .4s,border-color .4s}
  .dept:hover{background:rgba(200,200,200,.08);border-color:var(--line)}
  .dept-n{font-family:var(--serif);color:var(--red-soft);font-size:20px}
  .dept h3{font-family:var(--serif);font-weight:400;font-size:26px;margin:22px 0 10px}
  .dept p{color:var(--muted-on-ink);line-height:1.65;font-size:15px}
  .about-values{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,80px);align-items:center}
  .quote{margin:0;font-family:var(--serif);font-weight:300;font-size:clamp(34px,4.4vw,64px);line-height:1.15;border-inline-start:3px solid var(--red);padding-inline-start:clamp(18px,2.4vw,36px)}
  .cta-pair{display:grid;grid-template-columns:1fr 1fr;gap:clamp(12px,1.6vw,24px)}
  .cta-card{position:relative;display:grid;gap:8px;padding:clamp(28px,4vw,56px);background:var(--stone);transition:background .4s,color .4s;min-height:220px;align-content:end}
  .cta-card small{color:var(--muted);font-size:15px}
  .cta-card b{font-family:var(--serif);font-weight:300;font-size:clamp(36px,4vw,60px)}
  .cta-card .arr{position:absolute;top:clamp(24px,3vw,40px);left:clamp(24px,3vw,40px);font-size:28px;transition:transform .4s var(--ease)}
  .cta-card:hover .arr{transform:translateX(-8px)}
  .cta-card.dark{background:var(--ink);color:#fff}.cta-card.dark small{color:var(--muted-on-ink)}
  .cta-card:hover{background:var(--red);color:#fff}.cta-card:hover small{color:#fff}
  @media (max-width:980px){.depts{grid-template-columns:1fr 1fr}}
  @media (max-width:820px){.ah-grid,.about-values,.cta-pair{grid-template-columns:1fr}.types{grid-template-columns:1fr}.depts{grid-template-columns:1fr}}
</style>
