---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ClientMarquee from '../components/home/ClientMarquee.astro';
import ContactBlock from '../components/home/ContactBlock.astro';
import { getClients } from '../lib/content';
const clients = getClients();
---
<Base title="בין לקוחותינו" description="בין לקוחותיו של משרד טטרו שחר אדריכלים: יזמים, חברות בנייה וגופים ציבוריים מהמובילים בישראל.">
  <PageHero title="בין לקוחותינו" kicker="יזמים, חברות וגופים ציבוריים" lead="לאורך יותר מ-40 שנה תכננו עבור חברות ויזמים מהמובילים בענף. אצל רובם הפכנו ל״אדריכלי הבית״." crumbs={[{ label: 'בין לקוחותינו' }]} short />
  <ClientMarquee />
  <section class="wrap on-stone">
    <ul class="logo-grid" data-reveal="children">
      {clients.map((c) => <li title={c.name}><Image src={c.logo} alt={c.name} height={160} format="webp" loading="lazy" /></li>)}
    </ul>
  </section>
  <ContactBlock />
</Base>
<style is:global>
  .logo-grid{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:clamp(10px,1.2vw,18px)}
  .logo-grid li{background:#fff;aspect-ratio:3/2;display:grid;place-items:center;padding:22px;transition:box-shadow .4s,transform .4s var(--ease)}
  .logo-grid li:hover{box-shadow:0 14px 34px rgba(30,30,30,.12);transform:translateY(-4px)}
  .logo-grid img{max-width:100%;max-height:100%;width:auto;height:auto;object-fit:contain;filter:grayscale(1);opacity:.7;transition:filter .4s,opacity .4s}
  .logo-grid li:hover img{filter:none;opacity:1}
  @media (max-width:560px){.logo-grid{grid-template-columns:1fr 1fr}}
</style>
