---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getTeam } from '../lib/content';
const { partners, staff, closing } = getTeam();
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---
<Base title="הצוות" description="הכירו את הצוות של טטרו שחר אדריכלים: השותפים גבי טטרו וגדי שחר, ואדריכלים, הנדסאים ואנשי מקצוע במשרד בנתניה.">
  <PageHero title="פגשו את הצוות" kicker="האנשים שמאחורי הפרויקטים" lead="כ-25 אדריכלים, הנדסאים, מדמי״ם ואנשי מקצוע, בהובלת שני השותפים." crumbs={[{ label: 'הצוות' }]} short />

  <section class="wrap partners">
    {partners.map((p, i) => (
      <article class:list={['partner', { flip: i % 2 === 1 }]}>
        <figure class="partner-pic" data-reveal>
          {p.photo ? <Image src={p.photo} alt={p.name} width={720} height={900} fit="cover" format="webp" /> : <span class="initials">{initials(p.name)}</span>}
        </figure>
        <div class="partner-text" data-reveal="children">
          <span class="kicker-dark">{p.role}</span>
          <h2 class="h2">{p.name}</h2>
          {p.bio?.map((b) => <p>{b}</p>)}
        </div>
      </article>
    ))}
  </section>

  <section class="wrap on-stone staff">
    <div class="section-head"><h2 class="h2 split">הצוות</h2></div>
    <ul class="staff-grid" data-reveal="children">
      {staff.map((s) => (
        <li class="person">
          <div class="person-pic">
            {s.photo ? <Image src={s.photo} alt={s.name} width={480} height={600} fit="cover" format="webp" loading="lazy" /> : <span class="initials" aria-hidden="true">{initials(s.name)}</span>}
          </div>
          <b>{s.name}</b>
          <span>{s.role}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap team-closing">
    <p class="stmt" data-fill>{closing}</p>
    <div class="closing-ctas">
      <a class="btn mag" href="/about"><span>על המשרד</span></a>
      <a class="btn sand mag" href="/contact"><span>צרו קשר</span></a>
    </div>
  </section>
</Base>
<style is:global>
  .partners{display:grid;gap:clamp(56px,8vw,120px)}
  .partner{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(32px,5vw,80px);align-items:center}
  .partner.flip .partner-pic{order:2}
  .partner-pic{margin:0;aspect-ratio:4/5;overflow:hidden;background:var(--stone);display:grid;place-items:center}
  .partner-pic img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);transition:filter .8s}
  .partner:hover .partner-pic img{filter:none}
  .partner-text .h2{margin:8px 0 22px}
  .partner-text p{line-height:1.8;max-width:56ch;margin-bottom:12px;color:#2b4252}
  .staff-grid{list-style:none;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:clamp(16px,2vw,28px)}
  .person{display:grid;gap:4px}
  .person-pic{aspect-ratio:4/5;overflow:hidden;background:#d9d6cf;display:grid;place-items:center;margin-bottom:12px}
  .person-pic img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);transition:filter .6s,transform .8s var(--ease)}
  .person:hover .person-pic img{filter:none;transform:scale(1.04)}
  .person b{font-family:var(--serif);font-weight:400;font-size:22px}
  .person span{color:var(--muted);font-size:14px}
  .initials{font-family:var(--serif);font-size:clamp(48px,5vw,72px);color:#9a8f7e;font-weight:300}
  .team-closing .stmt{font-family:var(--serif);font-weight:300;font-size:clamp(26px,3.2vw,46px);line-height:1.3;max-width:28ch}
  .closing-ctas{display:flex;gap:12px;margin-top:36px;flex-wrap:wrap}
  @media (max-width:820px){.partner{grid-template-columns:1fr}.partner.flip .partner-pic{order:0}.staff-grid{grid-template-columns:1fr 1fr}.person b{font-size:18px}}
</style>
