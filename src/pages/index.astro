---
import Base from '../layouts/Base.astro';
import { getProjects, getTeam, getClients } from '../lib/content';
const ps = getProjects();
console.log(`[content] ${ps.length} projects, ${getTeam().staff.length} staff, ${getClients().length} clients`);
---
<Base title="טטרו שחר אדריכלים" description="משרד אדריכלים ותכנון ערים בנתניה מאז 1978.">
  <section class="wrap"><h1 class="h1">בבנייה</h1><ul>{ps.map((p) => <li>{p.title} – {p.categoryLabel} ({p.images.length})</li>)}</ul></section>
</Base>
