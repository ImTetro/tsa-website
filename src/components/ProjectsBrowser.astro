---
import { getImage } from 'astro:assets';
import ProjectCard from './ProjectCard.astro';
import { CATEGORIES, type Category, type Project } from '../lib/content';
interface Props { projects: Project[]; active: Category | 'all' }
const { projects, active } = Astro.props;
// named projects first, "more projects" placeholders last
const list = [...projects].sort((a, b) => Number(a.placeholder) - Number(b.placeholder));
const previews = await Promise.all(list.map(async (p) => (await getImage({ src: p.cover, width: 520, format: 'webp' })).src));
const isIndex = active === 'all';
---
<section class="wrap-tight browser on-stone" data-browser={isIndex ? 'filter' : 'static'}>
  <div class="browser-bar">
    <nav class="chips" aria-label="תחומים">
      {isIndex
        ? <>
            <button class="chip" type="button" aria-pressed="true" data-f="all">הכל <small>{list.length}</small></button>
            {CATEGORIES.map((c) => <button class="chip" type="button" aria-pressed="false" data-f={c.key}>{c.label} <small>{list.filter((p) => p.category === c.key).length}</small></button>)}
          </>
        : <>
            <a class="chip" href="/projects">הכל</a>
            {CATEGORIES.map((c) => <a class="chip" href={`/projects/${c.slug}`} aria-current={c.key === active ? 'page' : undefined}>{c.label}</a>)}
          </>}
    </nav>
    <div class="view-toggle" role="group" aria-label="תצוגה">
      <button type="button" data-view-mode="grid" aria-pressed="true" title="רשת">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M2 2h7v7H2zM11 2h7v7h-7zM2 11h7v7H2zM11 11h7v7h-7z" fill="currentColor" /></svg><span class="sr">רשת</span>
      </button>
      <button type="button" data-view-mode="list" aria-pressed="false" title="רשימה">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><path d="M2 3h16v2H2zM2 9h16v2H2zM2 15h16v2H2z" fill="currentColor" /></svg><span class="sr">רשימה</span>
      </button>
    </div>
  </div>

  {list.length === 0 && <p class="lead empty">אין עדיין פרויקטים להצגה בתחום זה. <a href="/projects">לכל הפרויקטים</a></p>}

  <div class="grid browser-grid" id="browser-grid">
    {list.map((p) => <ProjectCard project={p} />)}
  </div>

  <table class="plist" id="browser-list" hidden>
    <thead><tr><th>פרויקט</th><th>תחום</th><th>עיר</th><th>שנה</th></tr></thead>
    <tbody>
      {list.map((p, i) => (
        <tr data-c={p.category} data-preview={previews[i]}>
          <td><a href={p.url}>{p.title}</a></td>
          <td>{p.urbanRenewal ? `${p.categoryLabel} · התחדשות עירונית` : p.categoryLabel}</td>
          <td>{p.city ?? '—'}</td>
          <td>{p.year ?? '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <div class="plist-preview" id="plist-preview" aria-hidden="true"><img alt="" /></div>
</section>
<style is:global>
  .browser{min-height:60vh}
  .browser-bar{display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap;margin-bottom:32px}
  .chip small{opacity:.6;font-size:12px;margin-inline-start:4px}
  .view-toggle{display:flex;gap:4px}
  .view-toggle button{border:1px solid rgba(15,44,63,.25);background:none;border-radius:8px;width:40px;height:40px;display:grid;place-items:center;cursor:pointer;color:var(--ink)}
  .view-toggle button[aria-pressed=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .plist{width:100%;border-collapse:collapse;font-size:17px}
  .plist th{text-align:right;font-size:13px;font-weight:600;color:var(--muted);padding:10px 8px;border-bottom:1px solid rgba(15,44,63,.25)}
  .plist td{padding:18px 8px;border-bottom:1px solid rgba(15,44,63,.12)}
  .plist td:first-child a{font-family:var(--serif);font-size:24px;display:block}
  .plist tr{transition:background .25s}
  .plist tbody tr:hover{background:rgba(255,255,255,.55)}
  .plist-preview{position:fixed;z-index:30;top:0;left:0;width:260px;aspect-ratio:4/3;pointer-events:none;opacity:0;transform:translate(-50%,-50%) scale(.9);transition:opacity .25s,transform .25s;box-shadow:0 18px 40px rgba(10,30,44,.25)}
  .plist-preview.on{opacity:1;transform:translate(-50%,-50%) scale(1)}
  .plist-preview img{width:100%;height:100%;object-fit:cover}
  .empty a{text-decoration:underline}
  @media (max-width:820px){.plist th:nth-child(4),.plist td:nth-child(4){display:none}.plist td:first-child a{font-size:20px}}
</style>
<script>
  import '../scripts/browser';
</script>
