---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { images: ImageMetadata[]; title: string }
const { images, title } = Astro.props;
const full = await Promise.all(images.map(async (im) => (await getImage({ src: im, width: Math.min(2200, im.width), format: 'webp' })).src));
const alt = (i: number) => `${title} – תמונה ${i + 1} מתוך ${images.length}`;
---
<div class="gallery" data-gallery={JSON.stringify(full)} data-title={title}>
  {images.map((im, i) => (
    <button type="button" class:list={['g-item', { tall: im.height > im.width * 1.15 }]} data-index={i} aria-label={`הגדלת ${alt(i)}`}>
      <Image src={im} alt={alt(i)} widths={[480, 800, 1200]} sizes="(max-width:820px) 100vw, 50vw" format="webp" loading={i < 2 ? 'eager' : 'lazy'} />
    </button>
  ))}
</div>

<dialog class="lightbox" id="lightbox" aria-label={`גלריית ${title}`}>
  <div class="lb-top">
    <span class="lb-count" aria-live="polite" dir="ltr"><b id="lb-n">1</b> / {images.length}</span>
    <button type="button" class="lb-close" id="lb-close" aria-label="סגירה">✕</button>
  </div>
  <figure class="lb-stage" id="lb-stage"><img id="lb-img" alt="" /></figure>
  {images.length > 1 && <button type="button" class="lb-nav lb-prev" id="lb-prev" aria-label="התמונה הקודמת">→</button>}
  {images.length > 1 && <button type="button" class="lb-nav lb-next" id="lb-next" aria-label="התמונה הבאה">←</button>}
</dialog>

<style is:global>
  .gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(8px,1.2vw,18px);grid-auto-flow:dense}
  .g-item{position:relative;display:block;padding:0;border:0;background:#D2D2D2;cursor:zoom-in;overflow:hidden;aspect-ratio:4/3}
  .g-item.tall{grid-row:span 2;aspect-ratio:auto}
  .g-item img{width:100%;height:100%;object-fit:cover;transition:transform 1s var(--ease)}
  .g-item:hover img{transform:scale(1.04)}
  .g-item:focus-visible{outline:3px solid var(--red);outline-offset:3px}
  .lightbox{border:0;padding:0;margin:0;width:100vw;height:100vh;height:100dvh;max-width:none;max-height:none;background:rgba(6,18,27,.96);color:#fff;overflow:hidden}
  .lightbox::backdrop{background:rgba(6,18,27,.9)}
  .lb-top{position:absolute;top:0;right:0;left:0;display:flex;justify-content:space-between;align-items:center;padding:16px var(--pad);z-index:2}
  .lb-count{font-size:15px;color:#D6D6D6}.lb-count b{color:#fff;font-weight:600}
  .lb-close,.lb-nav{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.25);color:#fff;border-radius:50%;width:48px;height:48px;font-size:20px;cursor:pointer;display:grid;place-items:center}
  .lb-close:hover,.lb-nav:hover{background:rgba(255,255,255,.22)}
  .lb-stage{position:absolute;inset:72px 76px;margin:0;display:grid;place-items:center;touch-action:pan-y}
  .lb-stage img{max-width:100%;max-height:100%;object-fit:contain;user-select:none;-webkit-user-drag:none}
  .lb-nav{position:absolute;top:50%;transform:translateY(-50%);z-index:2}
  .lb-prev{right:14px}.lb-next{left:14px}
  @media (max-width:820px){
    .gallery{grid-template-columns:1fr}.g-item.tall{grid-row:auto;aspect-ratio:3/4}
    .lb-stage{inset:68px 0 84px}.lb-nav{top:auto;bottom:18px;transform:none}
  }
</style>
<script>
  import '../scripts/lightbox';
</script>
