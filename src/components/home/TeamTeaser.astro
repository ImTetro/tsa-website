---
import { Image } from 'astro:assets';
import { getTeam } from '../../lib/content';
const { partners, staff } = getTeam();
const people = [...partners, ...staff].filter((p) => p.photo).slice(0, 8);
const leaders = partners.map((p) => p.name).join(' ו');
---
<section class="wrap team-teaser on-stone">
  <div class="tt-grid">
    <div>
      <h2 class="h2 split">הצוות שלנו</h2>
      <p class="lead" style="margin-top:20px">כ-25 אדריכלים, הנדסאים ומדמי״ם בהובלת {leaders}. מחלקות תכנון, תב״ע, רישוי והדמיות, תחת קורת גג אחת בנתניה.</p>
      <a class="btn mag" href="/team" style="margin-top:28px"><span>הכירו את הצוות</span></a>
    </div>
    <a class="faces" href="/team" aria-label="לעמוד הצוות" data-reveal="children">
      {people.map((p) => (
        <figure><Image src={p.photo!} alt="" width={240} height={300} fit="cover" /><figcaption>{p.name}</figcaption></figure>
      ))}
    </a>
  </div>
</section>
<style is:global>
  .tt-grid{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(32px,5vw,80px);align-items:center}
  .faces{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
  .faces figure{margin:0;position:relative;overflow:hidden;aspect-ratio:4/5;background:#d6d4cf}
  .faces img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);transition:filter .5s,transform .8s var(--ease)}
  .faces figure:hover img{filter:none;transform:scale(1.05)}
  .faces figcaption{position:absolute;inset:auto 0 0 0;padding:28px 8px 8px;font-size:12px;color:#fff;background:linear-gradient(0deg,rgba(10,30,44,.85),rgba(10,30,44,0))}
  @media (max-width:820px){.tt-grid{grid-template-columns:1fr}.faces{gap:6px}.faces figcaption{display:none}}
</style>
