---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { sketch: ImageMetadata; render: ImageMetadata; teaser?: boolean }
const { sketch, render, teaser = true } = Astro.props;
---
<section class:list={["wrap", { "ur-teaser": teaser }]}>
  <div class:list={[{ ur: teaser }]}>
    {teaser && <div>
      <p class="kicker-dark">התחדשות עירונית</p>
      <h2 class="h2 split">מהשרטוט לבניין</h2>
      <p class="lead" style="margin-top:20px">פינוי-בינוי מחליף בנייני שיכון ישנים במגדלים חדשים, עם דירה חדשה וגדולה יותר לכל דייר. אנחנו מלווים את הדיירים ואת היזם לאורך כל הדרך.</p>
      <ol class="steps" data-reveal="children">
        <li>פגישת היכרות עם נציגות הדיירים</li>
        <li>בדיקת היתכנות ותכנון ראשוני</li>
        <li>אישור תב״ע והיתר בנייה</li>
        <li>ליווי אדריכלי עד המסירה</li>
      </ol>
      <div class="ur-ctas">
        <a class="btn mag" href="/urban-renewal"><span>על התחדשות עירונית</span></a>
        <a class="more-link" href="/contact?subject=urban">נציגות דיירים? קבעו פגישה <span class="arr">→</span></a>
      </div>
    </div>}
    <div class="compare" id="compare" role="img" aria-label="השוואה בין שרטוט להדמיה של פרויקט גד מכנס. גררו כדי להשוות.">
      <Image src={render} alt="" widths={[600, 1000]} sizes="(max-width:820px) 100vw, 50vw" format="webp" />
      <Image class="sk" id="sk" src={sketch} alt="" widths={[600, 1000]} sizes="(max-width:820px) 100vw, 50vw" format="webp" />
      <span class="tagL">שרטוט</span><span class="tagR">הדמיה</span>
      <div class="handle" id="handle"><i aria-hidden="true">⇆</i></div>
    </div>
  </div>
</section>
<style is:global>
  .ur{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,5vw,80px);align-items:center}
  .steps{list-style:none;counter-reset:s;margin:28px 0 32px;padding:0;display:grid;gap:14px}
  .steps li{counter-increment:s;display:flex;gap:14px;align-items:baseline;font-size:17px;border-bottom:1px solid rgba(30,30,30,.12);padding-bottom:12px}
  .steps li:before{content:"0" counter(s);font-family:var(--serif);color:#B90006;font-size:22px}
  .ur-ctas{display:flex;gap:24px;align-items:center;flex-wrap:wrap}
  .compare{position:relative;aspect-ratio:4/5;max-height:86vh;overflow:hidden;touch-action:pan-y;cursor:ew-resize;user-select:none;width:100%}
  .compare img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;pointer-events:none}
  .compare .sk{clip-path:inset(0 50% 0 0)}
  .compare .handle{position:absolute;top:0;bottom:0;left:50%;width:2px;background:#fff;transform:translateX(-1px)}
  .compare .handle i{position:absolute;top:50%;left:50%;width:52px;height:52px;border-radius:50%;background:#fff;transform:translate(-50%,-50%);display:grid;place-items:center;color:var(--ink);font-style:normal;font-size:18px;box-shadow:0 4px 18px rgba(0,0,0,.25)}
  .compare .tagL,.compare .tagR{position:absolute;top:14px;font-size:13px;padding:4px 10px;border-radius:20px;background:rgba(20,20,20,.6);color:#fff;backdrop-filter:blur(6px)}
  .compare .tagL{left:14px}.compare .tagR{right:14px}
  @media (max-width:820px){.ur{grid-template-columns:1fr}}
</style>

<script>
  import '../../scripts/compare';
</script>
